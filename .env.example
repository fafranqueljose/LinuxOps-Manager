# ==============================================================================
# LinuxOps Manager — Configuración de Entorno (Ejemplo)
# ==============================================================================

# Entorno de despliegue: development | staging | production
ENVIRONMENT=production
DEBUG=false
APP_NAME="LinuxOps Manager"
APP_URL=https://linuxops.local
API_V1_PREFIX=/api/v1

# Seguridad y Criptografía
# Generar claves seguras con: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_VERY_SECURE_64_CHAR_HEX_KEY_IN_PRODUCTION
SESSION_COOKIE_NAME=linuxops_session
SESSION_EXPIRE_MINUTES=480
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
ENCRYPTION_KEY=CHANGE_THIS_TO_A_32_BYTE_BASE64_KEY_FOR_DATA_AT_REST

# Base de datos PostgreSQL
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=linuxops_db
POSTGRES_USER=linuxops_user
POSTGRES_PASSWORD=CHANGE_THIS_POSTGRES_PASSWORD_STRONG
DATABASE_URL=postgresql+asyncpg://linuxops_user:CHANGE_THIS_POSTGRES_PASSWORD_STRONG@db:5432/linuxops_db

# CA Interna y Certificados para mTLS con Agentes
PKI_CA_DIR=/etc/linuxops/pki
PKI_CA_CERT=/etc/linuxops/pki/ca.crt
PKI_CA_KEY=/etc/linuxops/pki/ca.key
PKI_CA_PASSPHRASE=CHANGE_THIS_PASSPHRASE_FOR_CA_KEY
AGENT_CERT_VALIDITY_DAYS=365
AGENT_ENROLLMENT_TOKEN_EXPIRE_MINUTES=30

# Heartbeat y Detección de Agentes
AGENT_HEARTBEAT_TIMEOUT_SECONDS=45
AGENT_DEGRADED_THRESHOLD_SECONDS=90

# Rate Limiting y Protección contra Fuerza Bruta
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=120

# CORS (Orígenes autorizados, separados por coma)
CORS_ORIGINS="https://linuxops.local,http://localhost:3000,http://localhost:5173"

# Primer Usuario Administrador (Solo para inicialización segura inicial)
INITIAL_ADMIN_EMAIL=admin@linuxops.local
INITIAL_ADMIN_USERNAME=admin
# La contraseña inicial debe establecerse mediante el script de setup seguro o cambiarse en el primer inicio de sesión

